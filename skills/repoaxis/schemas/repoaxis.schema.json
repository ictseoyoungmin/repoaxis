{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoaxis.dev/schema/repoaxis.schema.json",
  "title": "Repoaxis Index",
  "type": "object",
  "required": ["schema_version", "tool", "authority", "repository", "generated", "annotations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "repoaxis" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "authority": { "const": "git+working-tree" },
    "repository": {
      "type": "object",
      "required": ["root", "head_sha", "head_ref"],
      "additionalProperties": false,
      "properties": {
        "root": { "const": "." },
        "head_sha": { "type": ["string", "null"] },
        "head_ref": { "type": ["string", "null"] }
      }
    },
    "generated": {
      "type": "object",
      "required": ["nodes", "edges", "refresh"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "git_changes": { "type": "array", "items": { "$ref": "#/$defs/gitChange" } },
        "refresh": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["agent_note"],
        "additionalProperties": false,
        "properties": { "agent_note": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "commitContext": {
      "type": "object",
      "required": ["sha", "author_name", "authored_at", "committed_at", "subject"],
      "additionalProperties": false,
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "author_name": { "type": "string" },
        "authored_at": { "type": "string", "minLength": 1 },
        "committed_at": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" }
      }
    },
    "gitState": {
      "type": "object",
      "required": ["tracked", "working", "staged", "conflicted"],
      "additionalProperties": false,
      "properties": {
        "tracked": { "type": "boolean" },
        "working": { "enum": ["clean", "modified", "added", "deleted", "renamed", "copied", "type-changed", "untracked", "conflicted"] },
        "staged": {
          "oneOf": [
            { "const": false },
            { "enum": ["modified", "added", "deleted", "renamed", "copied", "type-changed", "conflicted"] }
          ]
        },
        "conflicted": { "type": "boolean" },
        "rename_from": { "type": "string", "minLength": 1 },
        "copy_from": { "type": "string", "minLength": 1 },
        "similarity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "conflict_code": { "type": "string", "minLength": 2, "maxLength": 2 },
        "last_commit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/commitContext" }
          ]
        }
      }
    },
    "gitChange": {
      "type": "object",
      "required": ["path", "tracked", "working", "staged", "conflicted"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "tracked": { "type": "boolean" },
        "working": { "enum": ["clean", "modified", "added", "deleted", "renamed", "copied", "type-changed", "untracked", "conflicted"] },
        "staged": {
          "oneOf": [
            { "const": false },
            { "enum": ["modified", "added", "deleted", "renamed", "copied", "type-changed", "conflicted"] }
          ]
        },
        "conflicted": { "type": "boolean" },
        "rename_from": { "type": "string", "minLength": 1 },
        "copy_from": { "type": "string", "minLength": 1 },
        "similarity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "conflict_code": { "type": "string", "minLength": 2, "maxLength": 2 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["folder", "file", "class", "function"] },
        "path": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "source": {
          "type": "object",
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 },
            "signature": { "type": "string" },
            "start_column": { "type": "integer", "minimum": 0 },
            "end_column": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false,
          "required": ["start_line", "start_column", "end_line", "end_column", "signature"]
        },
        "git": { "$ref": "#/$defs/gitState" },
        "meta": { "type": "object" }
      },
      "additionalProperties": false,
      "allOf": [{
        "if": {
          "properties": { "type": { "enum": ["class", "function"] } },
          "required": ["type"]
        },
        "then": { "required": ["qualified_name", "parent_id", "source"] }
      }]
    },
    "edge": {
      "type": "object",
      "required": ["type", "from", "to"],
      "properties": {
        "type": { "enum": ["contains", "imports"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "meta": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
