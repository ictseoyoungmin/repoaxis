{
  "name": "repoaxis",
  "version": "0.15.0",
  "description": "Git-aware structural index for coding agents and humans.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictseoyoungmin/repoaxis.git"
  },
  "homepage": "https://github.com/ictseoyoungmin/repoaxis#readme",
  "bugs": {
    "url": "https://github.com/ictseoyoungmin/repoaxis/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repoaxis": "./bin/repoaxis"
  },
  "files": [
    ".agents/plugins/",
    ".codex-plugin/",
    ".claude-plugin/",
    "bin/",
    "skills/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test dev/tests/**/*.test.mjs",
    "validate:skill": "node dev/tools/validate-skill.mjs",
    "validate:package": "node dev/tools/validate-package.mjs",
    "check": "npm run validate:skill && npm run validate:package && npm test",
    "release:prepare": "node dev/tools/prepare-release.mjs",
    "release:dry-run": "node dev/tools/build-release.mjs"
  },
  "keywords": [
    "git",
    "repository",
    "code-navigation",
    "coding-agent",
    "structural-index"
  ]
}
